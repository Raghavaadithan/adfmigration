{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdevmigrationproject001"
		},
		"LS_SQLSERVER_TBLLKUP_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLSERVER_TBLLKUP'"
		},
		"LS_SQL_SP_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SP'"
		},
		"lS_LKUP_MAX_VALUE_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'lS_LKUP_MAX_VALUE'"
		},
		"lS_SQL_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'lS_SQL_PARQUET'"
		},
		"LS_SQLSERVER_TBLLKUP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost\\SQLEXPRESS"
		},
		"LS_SQLSERVER_TBLLKUP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlmigration"
		},
		"LS_SQLSERVER_TBLLKUP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azuresql"
		},
		"LS_SQL_SP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost\\SQLEXPRESS"
		},
		"LS_SQL_SP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlmigration"
		},
		"LS_SQL_SP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azuresql"
		},
		"lS_LKUP_MAX_VALUE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost\\SQLEXPRESS"
		},
		"lS_LKUP_MAX_VALUE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqlmigration"
		},
		"lS_LKUP_MAX_VALUE_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "azuresql"
		},
		"lS_SQL_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevmigprojectstorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdevmigrationproject001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"lS_SQL_PARQUET_accountKey": {
						"value": "[parameters('lS_SQL_PARQUET_accountKey')]"
					},
					"LS_SQLSERVER_TBLLKUP_password": {
						"value": "[parameters('LS_SQLSERVER_TBLLKUP_password')]"
					},
					"LS_SQL_SP_password": {
						"value": "[parameters('LS_SQL_SP_password')]"
					},
					"lS_LKUP_MAX_VALUE_password": {
						"value": "[parameters('lS_LKUP_MAX_VALUE_password')]"
					},
					"lS_SQL_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('lS_SQL_PARQUET_properties_typeProperties_url')]"
					},
					"LS_SQLSERVER_TBLLKUP_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLSERVER_TBLLKUP_properties_typeProperties_server')]"
					},
					"LS_SQLSERVER_TBLLKUP_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLSERVER_TBLLKUP_properties_typeProperties_database')]"
					},
					"LS_SQLSERVER_TBLLKUP_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLSERVER_TBLLKUP_properties_typeProperties_userName')]"
					},
					"LS_SQL_SP_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SP_properties_typeProperties_server')]"
					},
					"LS_SQL_SP_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SP_properties_typeProperties_database')]"
					},
					"LS_SQL_SP_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SP_properties_typeProperties_userName')]"
					},
					"lS_LKUP_MAX_VALUE_properties_typeProperties_server": {
						"value": "[parameters('lS_LKUP_MAX_VALUE_properties_typeProperties_server')]"
					},
					"lS_LKUP_MAX_VALUE_properties_typeProperties_database": {
						"value": "[parameters('lS_LKUP_MAX_VALUE_properties_typeProperties_database')]"
					},
					"lS_LKUP_MAX_VALUE_properties_typeProperties_userName": {
						"value": "[parameters('lS_LKUP_MAX_VALUE_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}